# openDAW Environment Configuration
# Copy this file to .env.local and fill in your actual values

# Supabase Configuration (Required for Authentication & AI Features)
# Get these from your Supabase project settings
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Development Configuration
NODE_ENV=development

# Optional: Custom API Endpoints (Advanced Users)
# VITE_API_BASE_URL=http://localhost:3000

# Note: Never commit your actual .env.local file to version control!
# Add .env.local to your .gitignore file to keep your secrets safe.

